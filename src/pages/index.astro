---
import { getCollection } from 'astro:content';
import ChirpingLayout from '../layouts/ChirpingLayout.astro';
import FeaturedPost from '../components/chirping/FeaturedPost.astro';
import PostFeed from '../components/chirping/PostFeed.astro';
import Pagination from '../components/Pagination.astro';

const POSTS_PER_PAGE = 10;
const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);
const pagePosts = allPosts.slice(0, POSTS_PER_PAGE);
const toPost = (p: typeof allPosts[0]) => ({
  slug: p.id, title: p.data.title, description: p.data.description,
  date: p.data.date, tags: p.data.tags, cover: p.data.cover,
});
---

<ChirpingLayout>
  <FeaturedPost post={toPost(pagePosts[0])} />
  <PostFeed posts={pagePosts.slice(1).map(toPost)} />
  <Pagination currentPage={1} totalPages={totalPages} />
</ChirpingLayout>
