---
interface Props {
  slug: string;
  title: string;
  description: string;
  date: Date;
  tags: string[];
  cover?: string;
  size?: 'featured' | 'large' | 'normal' | 'small';
  readingTime?: number;
}

const { slug, title, description, date, tags, cover, size = 'normal', readingTime } = Astro.props;

const d = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

// Tag → gradient fallback when no cover image
const tagGradients: Record<string, string> = {
  kubernetes: 'linear-gradient(135deg, #0d2744 0%, #1a3a6a 100%)',
  k8s: 'linear-gradient(135deg, #0d2744 0%, #1a3a6a 100%)',
  linux: 'linear-gradient(135deg, #1a3322 0%, #0d2218 100%)',
  ubuntu: 'linear-gradient(135deg, #1a3322 0%, #0d2218 100%)',
  devops: 'linear-gradient(135deg, #2a1a44 0%, #1a0d33 100%)',
  sre: 'linear-gradient(135deg, #2a1a44 0%, #1a0d33 100%)',
  dns: 'linear-gradient(135deg, #0d3344 0%, #0d2233 100%)',
  networking: 'linear-gradient(135deg, #0d3344 0%, #0d2233 100%)',
  security: 'linear-gradient(135deg, #3a1a1a 0%, #2a0d0d 100%)',
  ssl: 'linear-gradient(135deg, #3a1a1a 0%, #2a0d0d 100%)',
  apparmor: 'linear-gradient(135deg, #3a1a1a 0%, #2a0d0d 100%)',
  'claude-code': 'linear-gradient(135deg, #1a2a44 0%, #0d1a33 100%)',
  graphify: 'linear-gradient(135deg, #1a2a44 0%, #0d1a33 100%)',
  hooks: 'linear-gradient(135deg, #1a2a44 0%, #0d1a33 100%)',
};

const primaryTag = tags[0]?.toLowerCase() || '';
const gradient = tagGradients[primaryTag] || 'linear-gradient(135deg, #15171a 0%, #2a2a2a 100%)';

const bgStyle = cover
  ? `background-image: url(${cover})`
  : `background: ${gradient}`;
---

<article class:list={['j2card', `j2card--${size}`]}>
  <a href={`/${slug}`} class="j2card__link" aria-label={title}>
    <div class="j2card__bg" style={bgStyle}></div>
    <div class="j2card__overlay"></div>
    <div class="j2card__content">
      {tags.length > 0 && (
        <span class="j2card__tag">{tags[0]}</span>
      )}
      <div class="j2card__text">
        <h2 class="j2card__title">{title}</h2>
        {(size === 'featured' || size === 'large') && (
          <p class="j2card__excerpt">{description}</p>
        )}
        <div class="j2card__meta">
          <span class="j2card__author">Deepak Gupta</span>
          <span class="j2card__dot">·</span>
          <time datetime={date.toISOString()}>{d}</time>
          {readingTime && (
            <>
              <span class="j2card__dot">·</span>
              <span>{readingTime} min read</span>
            </>
          )}
        </div>
      </div>
    </div>
  </a>
</article>

<style>
.j2card {
  position: relative;
  border-radius: 6px;
  overflow: hidden;
  transition: transform 0.2s;
}
.j2card:hover { transform: translateY(-3px); }

/* Sizes */
.j2card--featured { aspect-ratio: 21/10; }
.j2card--large    { aspect-ratio: 16/9; }
.j2card--normal   { aspect-ratio: 16/9; }
.j2card--small    { aspect-ratio: 4/3; }

.j2card__link { display: block; width: 100%; height: 100%; text-decoration: none; color: #fff; }

.j2card__bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  transition: transform 0.4s;
}
.j2card:hover .j2card__bg { transform: scale(1.04); }

.j2card__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,0.2) 40%, rgba(0,0,0,0.85) 100%);
}

.j2card__content {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 14px 16px;
}

.j2card__tag {
  display: inline-block;
  font-size: 0.65rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  background: rgba(255,255,255,0.2);
  color: #fff;
  padding: 3px 9px;
  border-radius: 3px;
  backdrop-filter: blur(4px);
  align-self: flex-start;
}

.j2card__text {}

.j2card__title {
  font-size: 1.05rem;
  font-weight: 700;
  line-height: 1.3;
  color: #fff;
  text-shadow: 0 1px 3px rgba(0,0,0,0.5);
  margin-bottom: 6px;
}
.j2card--featured .j2card__title { font-size: 1.7rem; }
.j2card--large .j2card__title    { font-size: 1.25rem; }

.j2card__excerpt {
  font-size: 0.875rem;
  color: rgba(255,255,255,0.8);
  line-height: 1.5;
  margin-bottom: 10px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.j2card__meta {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.72rem;
  color: rgba(255,255,255,0.6);
}
.j2card__dot { color: rgba(255,255,255,0.3); }
.j2card__author { font-weight: 500; }
</style>
